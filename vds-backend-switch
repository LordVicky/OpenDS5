#!/bin/sh
# Privileged half of the DS5 Bridge backend switch, invoked via pkexec by
# the companion app. Handles only the system-level pieces; the app manages
# the per-user service and controller registration itself.
set -e

# binary reinstalls strip file capabilities; keep rootless mode viable
setcap 'cap_net_bind_service,cap_net_raw+eip' /usr/local/bin/vdsd 2>/dev/null || true

case "$1" in
  kernel)
    modprobe vds_hcd
    # heal ownership/permissions left over from older root-mode installs
    chgrp vds /dev/vds[0-9]* 2>/dev/null && chmod 660 /dev/vds[0-9]* || true
    [ -d /var/lib/vds ] && chown -R vds:vds /var/lib/vds || true
    [ -e /var/log/vdsd.log ] && chown vds:vds /var/log/vdsd.log || true
    systemctl reset-failed vdsd.service 2>/dev/null || true
    systemctl enable --now vdsd.service
    ;;
  rootless)
    systemctl disable --now vdsd.service 2>/dev/null || true
    ;;
  *)
    echo "usage: vds-backend-switch kernel|rootless" >&2
    exit 1
    ;;
esac
